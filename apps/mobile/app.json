{
  "expo": {
    "name": "Coastal Forager",
    "slug": "coastal-forager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coastalforager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mendus59.coastalforager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b6e79",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mendus59.coastalforager"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1b7f4c"
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "groupIdentifier": "group.com.mendus59.coastalforager",
          "widgets": [
            {
              "name": "BeachTide",
              "displayName": "Low tide",
              "description": "Your beach and species, colored by today's rating, with the low tide time.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              },
              "android": {
                "minWidth": 180,
                "minHeight": 40,
                "targetCellWidth": 3,
                "targetCellHeight": 1,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
